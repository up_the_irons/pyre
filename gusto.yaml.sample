# Gusto General Ledger account mapping.
#
# Maps Gusto "Account Type" values to your Pyre Chart of Accounts.
# Use colon-delimited account paths from your Chart of Accounts
# (e.g. "Expenses:Payroll:Wages"). Run the import and any unmapped
# account types will be flagged as errors.
#
# Values can be:
#   - A single account path (all splits of that type go to one account)
#   - A dict of description substrings -> account paths (for finer control)
account_map:
  RegularWages: "Salaries & Wages"
  HolidayWages: "Salaries & Wages"
  BenefitCompanyContribution: "Employee Benefits"
  BenefitLiability: "Payroll Liabilities"
  DebitNetPay: "Checking Account"
  DebitTax: "Checking Account"

  # Example: map employer taxes to different accounts by description
  # EmployerTax: "Payroll Taxes"            # simple: all to one account
  EmployerTax:                               # or map by description substring:
    Social Security: "Payroll Taxes:FICA"
    Medicare: "Payroll Taxes:FICA"
    FUTA: "Payroll Taxes:FUTA"
    SUI: "Payroll Taxes:SUI"
    ETT: "Payroll Taxes:ETT"
